{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; if [ -x \"$S\" ]; then SET_AGENT_NAME=set-copilot \"$S\" hook session-start; else echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"[set-agent-comm] ⚠ `sac` is not installed on this machine (not on PATH, not in ~/.local/bin), so this project is OFF the bus here: no wake-ups, no unread-mail check, no heartbeat. Fix: run `bin/sac.mjs setup` from a set-agent-comm checkout on this machine, then restart the session.\"}}'; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-skill",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-activity",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-leakscan",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-question-relay",
            "timeout": 3600
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; [ -x \"$S\" ] && SET_AGENT_NAME=set-copilot \"$S\" hook watch-guard || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; [ -x \"$S\" ] && SET_AGENT_NAME=set-copilot \"$S\" hook heartbeat || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [],
    "SubagentStart": [],
    "SubagentStop": [],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "set-hook-waveboard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "set-hook-wait-detect",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; [ -x \"$S\" ] && SET_AGENT_NAME=set-copilot \"$S\" hook stop || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "SET_COPILOT_DIR=\"$CLAUDE_PROJECT_DIR/.set/copilot/${CLAUDE_CODE_SESSION_ID:-shared}\" npx set-copilot stop",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "SET_COPILOT_DIR=\"$CLAUDE_PROJECT_DIR/.set/copilot/${CLAUDE_CODE_SESSION_ID:-shared}\" npx set-copilot wall-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

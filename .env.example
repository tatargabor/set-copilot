# Soniox speech-to-text API key (required) — https://soniox.com
SONIOX_API_KEY=

# Optional overrides (normally set in set-copilot.config.json instead)
# SET_COPILOT_DIR=/tmp/set-copilot
# MIC_SOURCE=
# MONITOR_SOURCE=
# SONIOX_MODE=rt          # rt (default, low latency) | chunk (10s async fallback)
